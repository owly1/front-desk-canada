# Copy to .env locally. Never commit credentials.
DB_PATH=data/frontdesk.sqlite3
# Required for dashboard and tools. Generate different long random values.
ADMIN_TOKEN=
AGENT_SECRET=
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Only configured and tested languages may be advertised.
SUPPORTED_LANGUAGES=en,fr,zh
PUBLIC_BASE_URL=http://127.0.0.1:8000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Live SMS is opt-in and restricted to these consenting test recipients.
ENABLE_LIVE_SMS=false
SMS_ALLOWLIST=
DEMO_MODE=true
